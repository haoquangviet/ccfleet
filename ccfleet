#!/bin/sh
# ccfleet shim (macOS / Linux): runs ccfleet.py with the repo's .venv when present, else the first
# python3 >= 3.10 on PATH. Symlink it onto your PATH, e.g.:
#   ln -s "$PWD/ccfleet" ~/.local/bin/ccfleet
# (or run `./ccfleet shortcut`, which writes ~/.local/bin/ccfleet with this machine's paths baked in).
SELF=$0
while [ -L "$SELF" ]; do  # follow the symlink back to the repo
  LINK=$(readlink "$SELF")
  case $LINK in /*) SELF=$LINK ;; *) SELF=$(dirname "$SELF")/$LINK ;; esac
done
DIR=$(cd "$(dirname "$SELF")" && pwd)
PY=
if [ -x "$DIR/.venv/bin/python" ]; then
  PY="$DIR/.venv/bin/python"
else
  for c in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
      PY=$c
      break
    fi
  done
fi
if [ -z "$PY" ]; then
  echo "ccfleet needs Python 3.10 or newer — macOS: brew install python; Linux: your package manager" >&2
  exit 1
fi
export PYTHONIOENCODING=utf-8
exec "$PY" "$DIR/ccfleet.py" "$@"
